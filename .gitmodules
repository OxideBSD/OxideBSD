	branch = oxidebsd
[submodule "external/mit/rust"]
	path = external/mit/rust
	url = https://github.com/OxideBSD/rust-oxidebsd.git
	branch = oxidebsd
[submodule "external/apache2/llvm"]
	path = external/apache2/llvm
	url = https://github.com/OxideBSD/llvm-project-oxidebsd.git
	branch = oxidebsd
