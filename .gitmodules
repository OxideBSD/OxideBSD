[submodule "external/gpl2/posixtestsuite"]
	path = external/gpl2/posixtestsuite
	url = https://github.com/Pomsky2011/posixtestsuite.git
	branch = oxidebsd
[submodule "external/bsd/limine"]
	path = external/bsd/limine
	url = https://github.com/Pomsky2011/limine-oxidebsd.git
	branch = oxidebsd
[submodule "external/gpl2/doomgeneric"]
	path = external/gpl2/doomgeneric
