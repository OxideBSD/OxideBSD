#!/bin/sh
#
# Reports changes to /etc/master.passwd and /etc/group since the last run and keeps a copy of
# each in /var/backups, readable only by root.

if [ -r /etc/defaults/periodic.conf ]; then
	. /etc/defaults/periodic.conf
	source_periodic_confs
fi

case "$daily_backup_passwd_enable" in
[Yy][Ee][Ss]) ;;
*) exit 0 ;;
esac

bak=/var/backups
mkdir -p $bak && chmod 755 $bak || exit 3
rc=0
for file in /etc/master.passwd /etc/group; do
	[ -f $file ] || continue
	copy=$bak/${file##*/}.bak
	if [ ! -f $copy ]; then
		cp -p $file $copy && chmod 600 $copy || rc=3
		continue
	fi
	if ! cmp -s $copy $file; then
		[ $rc -eq 0 ] && echo "Backing up the account files:"
		echo "$file has changed:"
		diff $copy $file | sed 's/^/  /'
		mv -f $copy $copy.2 2>/dev/null
		cp -p $file $copy && chmod 600 $copy || rc=3
		[ $rc -eq 0 ] && rc=1
	fi
done
exit $rc
