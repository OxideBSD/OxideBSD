# /etc/crontab: the system table; see crontab(5).
#
# Each job line names the user it runs as. Add local jobs here or, better, as files in
# /etc/cron.d, which cron also reads. Other users' tables are edited with crontab(1).
#
SHELL=/bin/sh
PATH=/etc:/bin:/sbin:/usr/bin:/usr/sbin
#
#minute	hour	mday	month	wday	who	command
#
# Rotate log files every hour, if necessary.
0	*	*	*	*	root	newsyslog
#
# The daily, weekly and monthly maintenance runs; see periodic(8).
1	3	*	*	*	root	periodic daily
15	4	*	*	6	root	periodic weekly
30	5	1	*	*	root	periodic monthly
