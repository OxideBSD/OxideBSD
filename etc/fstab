# /etc/fstab: the file systems mounted at boot; see fstab(5).
#
# rc.d/mountcritlocal mounts every entry that isn't noauto with `mount -a`. The root is mounted
# by the kernel, which finds it through /boot/fsconf: run fsconf_mkdb(8) after changing its line.
#
# Device	Mountpoint	FStype	Options		Dump	Pass#
/dev/gpt/rootfs	/		oxfs	rw		1	1
tmpfs		/dev/shm	tmpfs	rw,mode=1777	0	0
#
# Examples:
# tmpfs		/tmp		tmpfs	rw		0	0
# /usr/src	/mnt/src	nullfs	rw,noauto	0	0
