#!/sbin/init_sh
#
# PROVIDE: update
# REQUIRE: FILESYSTEMS
# BEFORE: LOGIN
# KEYWORD: shutdown
#
# The daemon that writes the file system's delayed writes to the disk every 30 seconds
# (update(8), OxideBSD-doc RAM_FLOOR.md §3.3.6).

. /etc/rc.subr

name="update"
desc="Periodically flush delayed file system writes"
rcvar="update_enable"
command="/sbin/${name}"
pidfile="/var/run/${name}.pid"

load_rc_config $name
run_rc_command "$1"
