#
# /etc/gettytab: terminal descriptions for getty(8); see gettytab(5).
#
# Records use the getcap(3) format: `name|alias:cap=value:flag:num#value:'. `tc=' continues
# with another record.
#
default:\
	:ce:ck:sp#9600:\
	:im=\r\nOxideBSD/%m (%h) (%t)\r\n\r\n:

#
# The console: a CRT with hardware tabs, whose terminal type is linux.
#
P|Pc|Pc console:\
	:ht:tt=linux:tc=default:

#
# Serial lines.
#
std.9600|9600-baud:\
	:sp#9600:tc=default:
std.38400|38400-baud:\
	:sp#38400:tc=default:
std.115200|115200-baud:\
	:sp#115200:tc=default:
3wire|3wire.9600:\
	:hc:sp#9600:tc=default:
