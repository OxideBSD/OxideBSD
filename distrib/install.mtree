#mtree v2.0
#
# distrib/install.mtree: everything the build installs into the system's file tree
# (OxideBSD-doc RAM_FLOOR.md §4.3), read by build.rs, which stages it into target/destdir and
# splits it into dist sets by distrib/sets/lists/*. mtree(5) syntax, plus:
#
#   src=artifact:NAME   a build product, by the name build.rs gives it
#   src=gen:NAME        a file list build.rs generates (zoneinfo, OpenSSL, the POSIX corpus...)
#   src=path            a file in this source tree
#   type=tree           installs a generated list under this directory
#   hardlink=./path     another name for an entry above
#
# A file's mode defaults to 0755 for an ELF executable or shared object and a #! script, 0644
# otherwise; a directory's to 0755. Everything is root's unless it says otherwise.
#
/set uid=0 gid=0
. type=dir
./bin type=dir
./sbin type=dir
./lost+found type=dir mode=0700
./usr type=dir
./usr/bin type=dir
./usr/sbin type=dir
