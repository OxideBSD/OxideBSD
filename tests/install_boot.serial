jset -- $(ls -i /bin/sh /sbin/mount); [ "$1" = "$3" ] && echo crunched > /root/note && [ "$(cat /root/note)" = crunched ] && touch /tmp/scratch && sysctl -n kern.disks | grep -q ide && a=$((6 * 7))for d in $(sysctl -n kern.disks); do [ "$(sysctl -n kern.disk.$d.kind)" = disk ] && break; done; gpart create -s gpt $d && gpart add -t efi -s 32m -l esp $d && gpart add -t oxfs -l target $d && [ -c /dev/gpt/target ] && newfs_oxfs /dev/gpt/target > /dev/null && mkdir -p /mnt && mount -t oxfs /dev/gpt/target /mnt && echo second > /mnt/f && [ "$(cat /root/note)" = crunched ] && umount /mnt && mount -t oxfs /dev/gpt/target /mnt && [ "$(cat /mnt/f)" = second ] && umount /mnt && fsck_oxfs -fn /dev/gpt/target > /dev/null && exec 3< /dev/${d}p2 && gpart delete -i 1 $d 2> /tmp/busy; [ -c /dev/${d}p1 ] && grep -q "in use" /tmp/busy && exec 3<&- && [ ! -e /dev/${d}p1 ] && [ -c /dev/${d}p2 ] && fsck_oxfs -fn /dev/${d}p2 > /dev/null && n=$(gpart show $d | grep -c oxfs)wsconsctl keyboard.encoding=de > /dev/null && [ "$(wsconsctl -n keyboard.encoding)" = de ] && echo type-$((1 + 1))-now && read x; wsconsctl keyboard.encoding=us > /dev/null; echo "mfsroot-ok $a keys=$x partitions=$n"