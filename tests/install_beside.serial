jcat > /tmp/ic <<'END'PARTITIONS=DEFAULTHOSTNAME=beside#!/bin/shc=/boot/efi/boot/limine/limine.confwhile IFS= read -r l; do printf '%s\n' "$l"; case $l in *kernel_path:*) echo '    kernel_cmdline: -D' ;; esac; done < $c > /tmp/c && cat /tmp/c > $cgrep -q 'Windows Boot Manager' $c && grep -q fake-windows /boot/efi/EFI/Microsoft/Boot/bootmgfw.efi && grep -q not-a-loader /boot/efi/EFI/BOOT/BOOTX64.EFIEND/usr/libexec/installer -f /tmp/ic && /usr/sbin/efibootmgr | grep -q '[*] OxideBSD' && echo beside-$((2 + 3))-done || echo install-failed-$((1 + 1))